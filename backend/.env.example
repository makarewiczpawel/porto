# Local development. On Railway these are set in the service variables.
# Adres można wkleić w formacie, jaki daje hosting (`postgresql://…` albo
# `postgres://…`) — aplikacja sama dokleja sterownik `+psycopg`.
# Na Railway wystarczy: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+psycopg://porto@localhost:5432/porto

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Registration is closed — this code is required to create an account.
INVITE_CODE=

# The frontend origin must be listed explicitly: the API sends credentials,
# and browsers reject a wildcard origin in that case.
CORS_ORIGINS=http://localhost:5173

# Production (porto.pmakarewicz.com + api-porto.pmakarewicz.com):
#   COOKIE_DOMAIN=.pmakarewicz.com
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Wymowa (Google Cloud Text-to-Speech) ──────────────────────────────────
# Bez klucza aplikacja działa normalnie, tylko bez nagrań: przycisk głośnika
# schodzi wtedy na głos wbudowany w przeglądarkę, a tryb „ze słuchu" jest
# pomijany. Klucz: konsola Google Cloud → API i usługi → Dane logowania →
# Utwórz klucz API, przy włączonym Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=

# Musi zaczynać się od `pt-PT-` — walidator odrzuca głosy brazylijskie.
# Pełną listę dostępnych zwraca GET /api/audio/voices.
TTS_VOICE_DEFAULT=pt-PT-Wavenet-A

# Zabezpieczenie przed rachunkiem z pętli. Cała baza to ~8 tys. znaków.
TTS_MONTHLY_CHAR_LIMIT=150000

# ── AI (Anthropic) ────────────────────────────────────────────────────────
# Bez klucza aplikacja działa normalnie, tylko ekrany AI mówią, że są
# wyłączone: nie ma generowania zestawów, przycisku „dlaczego źle?" ani trybu
# „przetłumacz zdanie". Klucz: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# Model używany do generowania i oceniania.
AI_MODEL=claude-opus-5

# Twardy limit miesięczny w dolarach. Po przekroczeniu funkcje AI zwracają 429
# z czytelnym komunikatem, a nauka i wymowa działają dalej bez zmian.
AI_MONTHLY_BUDGET_USD=5

# Ile pozycji wolno wygenerować za jednym razem.
AI_MAX_ITEMS_PER_SET=30
