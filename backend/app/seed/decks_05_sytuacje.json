  {
    "slug": "sytuacja-sklep",
    "name": "W sklepie",
    "icon": "🛒",
    "cefr_level": "A1",
    "position": 5,
    "description": "Wejść, zapytać, zapłacić, wyjść. Cała wizyta w jednej talii.",
    "items": [
      {"pt": "bom dia, faz favor", "pl": "dzień dobry, przepraszam", "type": "phrase", "pos": "expr", "level": "A1",
       "notes": "Tak zaczepiasz sprzedawcę. „Faz favor” to portugalskie „przepraszam, mam pytanie”, nie „proszę”.",
       "reply": ["Bom dia! Diga.", "Dzień dobry! Słucham."]},
      {"pt": "queria isto, se faz favor", "pl": "poproszę to", "type": "phrase", "pos": "expr", "level": "A1",
       "notes": "„Queria” dosłownie znaczy „chciałbym” — w sklepie to najgrzeczniejsza forma. „Quero” brzmi rozkazująco.",
       "reply": ["Com certeza.", "Oczywiście."]},
      {"pt": "quanto custa?", "pl": "ile to kosztuje?", "type": "phrase", "pos": "expr", "level": "A1",
       "reply": ["São dois euros e cinquenta.", "Dwa euro pięćdziesiąt."]},
      {"pt": "quanto é ao todo?", "pl": "ile razem?", "type": "phrase", "pos": "expr", "level": "A1",
